# Supabase Configuration
# You can find these values in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Application URL
# Use http://localhost:3000 for local development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Configuration
# You can find these values in your Stripe Dashboard -> Developers -> API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_secret_key"

# Stripe Webhook Secret
# Obtain this by running `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
